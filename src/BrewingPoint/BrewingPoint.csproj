<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Schedule I side of Brewing Point: a MelonLoader (IL2CPP) mod built on S1API.
       It compiles against the game's own generated assemblies, so build it on a PC that has
       Schedule I with MelonLoader run once:
         dotnet build src/BrewingPoint -c Release -p:GameDir="C:\...\steamapps\common\Schedule I"
       The game-independent half (BrewingPoint.Core) is compiled in. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BrewingPoint</AssemblyName>
    <RootNamespace>BrewingPoint</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GameDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../BrewingPoint.Core/**/*.cs" Exclude="../BrewingPoint.Core/obj/**;../BrewingPoint.Core/bin/**" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="S1API.Forked" Version="3.2.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)/MelonLoader/net6/MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/Il2CppAssemblies/*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDir)')" Text="Schedule I folder not found: $(GameDir). Pass -p:GameDir=&quot;...\Schedule I&quot; (no backslash at the end)." />
    <Error Condition="!Exists('$(GameDir)/MelonLoader/net6/MelonLoader.dll')" Text="MelonLoader 0.7.3 is not installed in $(GameDir)." />
    <Error Condition="!Exists('$(GameDir)/MelonLoader/Il2CppAssemblies/Assembly-CSharp.dll')" Text="Launch Schedule I once with MelonLoader (to the main menu), then build again." />
    <Warning Condition="!Exists('$(GameDir)/Mods/S1API.Il2Cpp.MelonLoader.dll')" Text="S1API is not installed: copy the Mods and Plugins folders from S1API-Forked-3.2.1.zip into the game folder." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/Mods" />
    <Copy SourceFiles="$(OutDir)NVorbis.dll" DestinationFolder="$(GameDir)/UserLibs" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(GameDir)/Mods and NVorbis.dll to UserLibs" />
  </Target>
</Project>
