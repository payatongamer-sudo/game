<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-independent half of Brewing Point: the sheets as code, the Minecraft file reader,
       the block-model mesher and the brewing rules. No Unity or Schedule I references, so it
       builds and is unit-tested anywhere. The MelonLoader mod compiles these files in. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BrewingPoint</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
</Project>
